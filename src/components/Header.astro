---
import Navigation from "@components/Navigation.astro";
import Social from "@components/Social.astro";
import ThemeIcon from "@components/ThemeIcon.astro";
---

<header
	class="sticky top-0 z-50 border-b border-border bg-surface/80 backdrop-blur-md supports-[backdrop-filter]:bg-surface/70"
>
	<nav
		class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center"
		aria-label="Main"
	>
		<a
			href="/"
			class="font-display font-bold text-lg tracking-tight text-fg hover:text-accent transition-colors duration-200"
		>
			Iain Kirkham
		</a>

		<!-- Desktop Navigation -->
		<div class="hidden md:flex items-center space-x-4">
			<Navigation />
		</div>

		<div class="flex items-center gap-1">
			<ThemeIcon />

			<button
				id="menu-button"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="menu-toggle block md:hidden p-2 rounded-lg text-fg hover:bg-surface-2 transition-colors duration-200"
			>
				<!-- Three bars that fold into an X while the panel opens. -->
				<span class="menu-icon" aria-hidden="true">
					<span class="menu-bar"></span>
					<span class="menu-bar"></span>
					<span class="menu-bar"></span>
				</span>
			</button>
		</div>
	</nav>
</header>

<!--
  Deliberately a sibling of <header>, not a child: the header sets
  backdrop-filter, which makes it a containing block for fixed-position
  descendants, so a panel nested inside it would size to the header instead
  of the viewport.
-->
<div
	id="mobile-menu"
	class="mobile-menu fixed inset-0 z-40 md:hidden bg-surface opacity-0 pointer-events-none"
	role="dialog"
	aria-modal="true"
	aria-label="Site menu"
>
	<div class="flex h-full flex-col max-w-6xl mx-auto px-4 pt-24 pb-10">
		<p class="meta text-muted mb-2 menu-item" style="--i:0">Menu</p>

		<Navigation variant="panel" />

		<div class="mt-auto pt-10 flex justify-center menu-item" style="--i:5">
			<Social />
		</div>
	</div>
</div>

<style is:global>
	/* Hamburger -> X */
	.menu-icon {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		width: 20px;
		height: 20px;
	}

	.menu-bar {
		display: block;
		height: 2px;
		width: 100%;
		border-radius: 2px;
		background-color: currentColor;
		transition:
			transform 0.3s ease,
			opacity 0.2s ease;
	}

	.menu-toggle[aria-expanded="true"] .menu-bar:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}

	.menu-toggle[aria-expanded="true"] .menu-bar:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle[aria-expanded="true"] .menu-bar:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	/* Panel.
	   `visibility` is switched with a zero-duration transition rather than
	   being interpolated: opening flips it immediately (so the panel is
	   focusable in the same frame), closing defers it until the fade ends. */
	.mobile-menu {
		visibility: hidden;
		transition:
			opacity 0.3s ease,
			visibility 0s linear 0.3s;
	}

	.mobile-menu.is-open {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transition:
			opacity 0.3s ease,
			visibility 0s linear 0s;
	}

	/* Items rise in sequence once the panel is open. */
	.mobile-menu .menu-item {
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 0.4s ease,
			transform 0.4s ease;
		transition-delay: calc(var(--i, 0) * 55ms);
	}

	.mobile-menu.is-open .menu-item {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu .menu-item {
			transform: none;
			transition-delay: 0ms;
		}
	}
</style>

<script>
	const menuButton = document.getElementById("menu-button");
	const mobileMenu = document.getElementById("mobile-menu");

	const FOCUSABLE =
		'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

	let isOpen = false;

	// The toggle lives in the header, outside the panel, so it has to be part
	// of the tab cycle or there is no keyboard route back to "close".
	const focusables = () => [
		...(menuButton ? [menuButton] : []),
		...Array.from(mobileMenu?.querySelectorAll<HTMLElement>(FOCUSABLE) ?? []),
	];

	const setMenuOpen = (open: boolean) => {
		isOpen = open;
		mobileMenu?.classList.toggle("is-open", open);
		menuButton?.setAttribute("aria-expanded", String(open));
		menuButton?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		// Keep the page behind the overlay from scrolling.
		document.body.style.overflow = open ? "hidden" : "";

		if (open) {
			// focus() no-ops while the panel is still visibility:hidden, so force
			// the style recalculation through before moving focus.
			void mobileMenu?.offsetHeight;
			mobileMenu?.querySelector<HTMLElement>(FOCUSABLE)?.focus();
		} else {
			menuButton?.focus();
		}
	};

	menuButton?.addEventListener("click", () => setMenuOpen(!isOpen));

	// Close on navigation so the overlay never survives a same-page anchor.
	mobileMenu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setMenuOpen(false));
	});

	document.addEventListener("keydown", (event) => {
		if (!isOpen) return;

		if (event.key === "Escape") {
			setMenuOpen(false);
			return;
		}

		if (event.key !== "Tab") return;

		const items = focusables();
		if (items.length === 0) return;

		const first = items[0];
		const last = items[items.length - 1];
		const active = document.activeElement;

		if (event.shiftKey && active === first) {
			event.preventDefault();
			last.focus();
		} else if (!event.shiftKey && active === last) {
			event.preventDefault();
			first.focus();
		}
	});

	// The panel is md:hidden; if the viewport grows past that while it is open,
	// close it so body scroll is not left locked on desktop.
	window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
		if (e.matches && isOpen) setMenuOpen(false);
	});
</script>
