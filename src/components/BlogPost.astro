---
import Card from "@components/Card.astro";
import { dateOptions } from "src/data/utils";

interface Props {
	title: string;
	url: string;
	description: string;
	date: Date;
}

const { title, url, description, date } = Astro.props;
---

<Card href={url}>
  <p class="meta text-muted">
    <time datetime={date.toISOString()}>
      {date.toLocaleDateString("en-GB", dateOptions)}
    </time>
  </p>
  <h3 class="font-sans text-lg font-bold mt-2 text-fg group-hover:text-accent transition-colors">
    {title}
  </h3>
  <p class="text-sm text-muted mt-2">{description}</p>
  <p class="meta mt-4 text-accent">read more &rarr;</p>
</Card>
