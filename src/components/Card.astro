---
interface Props {
	href: string;
	class?: string;
}

const { href, class: className = "" } = Astro.props;
---

<li class={`list-none ${className}`}>
  <a href={href} class="group block h-full no-underline">
    <div
      class="relative flex h-full flex-col rounded-sm border border-border bg-surface-2 p-5 transition-colors duration-200 group-hover:border-accent"
    >
      <!-- Unsaved-tab dot: the card reads as an editor pane that lights up on focus. -->
      <span
        aria-hidden="true"
        class="absolute right-3 top-3 h-1.5 w-1.5 rounded-full bg-accent opacity-0 transition-opacity duration-200 group-hover:opacity-100"
      ></span>
      <slot />
    </div>
  </a>
</li>
