---
interface Props {
	chart: string;
}

const { chart } = Astro.props;
---

<pre class="mermaid" data-mermaid set:text={chart}></pre>

<script>
	import mermaid from "mermaid";

	async function renderMermaidDiagrams() {
		const diagrams = document.querySelectorAll<HTMLPreElement>(
			"pre[data-mermaid]:not([data-processed])",
		);

		if (diagrams.length === 0) return;

		mermaid.initialize({
			startOnLoad: false,
			theme: document.documentElement.classList.contains("dark") ? "dark" : "default",
		});

		for (const diagram of diagrams) {
			const definition = diagram.textContent ?? "";
			const id = `mermaid-${crypto.randomUUID()}`;

			try {
				const { svg } = await mermaid.render(id, definition);
				diagram.innerHTML = svg;
				diagram.dataset.processed = "true";
			} catch (error) {
				console.error("Unable to render Mermaid diagram", error);
				diagram.dataset.processed = "error";
			}
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", renderMermaidDiagrams, { once: true });
	} else {
		renderMermaidDiagrams();
	}
</script>

<style>
	.mermaid {
		display: flex;
		justify-content: center;
		margin: 2rem 0;
		overflow-x: auto;
		padding: 1rem;
	}

	.mermaid :global(svg) {
		height: auto;
		max-width: 100%;
	}
</style>
