---
import type { Heading } from "@components/TableOfContents.astro";
import TableOfContents from "@components/TableOfContents.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { dateOptions, getTagStyles } from "src/data/utils";

interface Props {
	frontmatter: {
		title: string;
		description: string;
		pubDate: Date;
		tags: string[];
	};
	minutesRead: string;
	headings: Heading[];
}

const { frontmatter, minutesRead, headings } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} width="wide">
  <article class="py-8">
    <header class="mb-10">
      <h1 class="text-4xl font-black tracking-tight text-balance">
        {frontmatter.title}
      </h1>

      <p class="meta mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
        <time datetime={frontmatter.pubDate.toISOString()}>
          {frontmatter.pubDate.toLocaleDateString("en-GB", dateOptions)}
        </time>
        <span aria-hidden="true">&middot;</span>
        <span>{minutesRead}</span>
      </p>

      <p class="mt-4 text-lg text-muted">{frontmatter.description}</p>

      <div class="flex flex-wrap gap-2 mt-5">
        {
          frontmatter.tags.map((tag: string) => (
            <a href={`/tags/${tag}`} class={`no-underline ${getTagStyles(tag)}`}>
              #{tag}
            </a>
          ))
        }
      </div>
    </header>

    <TableOfContents headings={headings} variant="mobile" />

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12 lg:items-start">
      <div class="min-w-0 max-w-[68ch]">
        <slot />
      </div>

      <TableOfContents headings={headings} variant="desktop" />
    </div>

    <slot name="footer" />
  </article>
</BaseLayout>
