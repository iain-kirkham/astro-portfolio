---
import { getCollection } from "astro:content";
import BlogPost from "@components/BlogPost.astro";
import { VisitorCount } from "@components/VisitorCount.tsx";
import BaseLayout from "@layouts/BaseLayout.astro";
import { sortByDateDesc } from "src/data/utils";

const allPosts = await getCollection("blog");
const sortedPosts = sortByDateDesc(allPosts);
const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
  <section class="py-12">
    <h1>{pageTitle}</h1>
    <p class="text-muted max-w-2xl">
      Notes from my work as a developer &mdash; mostly AWS and Spring Boot,
      with some Rust experiments thrown in. I write up the projects I build,
      the problems I hit along the way, and takeaways from events I attend.
    </p>
    <p class="meta mt-4 text-muted">
      Visitor <VisitorCount client:load />
    </p>
  </section>

  <ul class="grid gap-4 sm:grid-cols-2 pb-12">
    {
      sortedPosts.map((post) => (
        <BlogPost
          url={`/blog/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.pubDate}
        />
      ))
    }
  </ul>
</BaseLayout>
