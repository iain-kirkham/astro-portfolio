---
import { getCollection } from "astro:content";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { sortProjectsByDate } from "src/data/utils";

const allProjects = await getCollection("projects");
const sortedProjects = sortProjectsByDate(allProjects);

const pageTitle = "Projects";
---

<BaseLayout pageTitle={pageTitle}>
  <section class="py-12">
    <h1>My Projects</h1>

    {
      sortedProjects.length === 0 ? (
        <p class="text-muted">No projects found yet. Please check back later.</p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2 mt-6">
          {sortedProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              technologies={project.data.technologies}
              liveUrl={project.data.liveUrl}
              githubUrl={project.data.githubUrl}
              id={project.id}
              status={project.data.status}
              publishDate={project.data.publishDate}
            />
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
