---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Error 404">
  <section class="py-24 text-center">
    <p class="meta text-muted">Error 404</p>
    <h1 class="text-5xl font-black tracking-tight">Page not found</h1>
    <p class="text-muted mt-4">
      Sorry, we couldn&rsquo;t find that page!
    </p>
    <a
      href="/"
      class="meta inline-block mt-8 px-4 py-2 rounded-lg bg-accent text-accent-fg no-underline hover:brightness-110 transition"
    >
      Back home
    </a>
  </section>
</BaseLayout>
