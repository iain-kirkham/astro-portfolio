---
import { getCollection } from "astro:content";
import BlogPost from "@components/BlogPost.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { sortByDateDesc } from "src/data/utils";

const pageTitle = "Home";
const allPosts = await getCollection("blog");
const sortedPosts = sortByDateDesc(allPosts);
---

<BaseLayout pageTitle={pageTitle}>
  <section class="py-16 border-b border-border">
    <p class="meta mb-4 text-muted">Software engineer</p>
    <h1 class="text-5xl sm:text-6xl font-black tracking-tight text-balance">
      Hi, I&rsquo;m Iain Kirkham
    </h1>
    <p class="text-lg text-muted mt-6 max-w-2xl">
      Software engineer, lifelong learner, and cloud enthusiast. I write about
      AWS, Spring Boot, and Rust adventures.
    </p>
    <a
      href="/about"
      class="meta inline-block mt-8 text-accent hover:underline"
    >
      Read more about me &rarr;
    </a>
  </section>

  <section class="py-12">
    <h2 class="meta mb-6 text-muted">Latest posts</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        sortedPosts.map((post) => (
          <BlogPost
            url={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
          />
        ))
      }
    </ul>
  </section>
</BaseLayout>
